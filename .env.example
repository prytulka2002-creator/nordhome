# PostgreSQL connection string. Example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Nova Poshta API key. Keep it secret.
NOVA_POSHTA_API_KEY=

# Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Customer email notifications (generic SMTP).
# Configure locally with: npm run email:setup
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
# Optional public site address, e.g. https://example.com
PUBLIC_URL=

# Admin panel. Change before publishing.
ADMIN_USERNAME=admin
# Run npm run admin:setup; do not store plaintext passwords in production.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

PORT=3001

# Production hosting
# Most hosts inject PORT automatically. HOST should normally remain 0.0.0.0.
HOST=0.0.0.0
NODE_ENV=production
